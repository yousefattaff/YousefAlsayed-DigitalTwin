# Copy to .env.local. Groq secrets are read by the Next.js API only.
NEXT_PUBLIC_DEPLOY_TARGET=vercel
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Optional local deployment helper target; this is not a browser setting.
TWIN_PRODUCTION_URL=https://yousefalsayed.me

# Optional external backend: select aws and provide a verified endpoint.
# NEXT_PUBLIC_DEPLOY_TARGET=aws
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL_FALLBACK=https://your-verified-backup-api.example.com
