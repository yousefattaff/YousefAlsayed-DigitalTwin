# Groq is the only chat provider
GROQ_API_KEY=your_groq_api_key_here

# Model Selection (optional overrides)
GROQ_MODEL=openai/gpt-oss-120b

# RAG content and local Chroma persistence
CONTENT_DIR=../content
CHROMA_DIR=.chroma
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.85

# Storage Configuration
USE_S3=false
S3_BUCKET=your_twin_memory_bucket_name
# Relative paths are resolved from backend/, independent of the shell's cwd.
MEMORY_DIR=.memory

# Security & Network
# Comma-separated origins. Use the deployed Vercel URL in production; do not use
# "*" when the frontend sends credentials or when restricting browser access.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=https://your-frontend.vercel.app

# AWS Deployment Info
AWS_ACCOUNT_ID=your_aws_account_id
DEFAULT_AWS_REGION=eu-north-1
PROJECT_NAME=twin
